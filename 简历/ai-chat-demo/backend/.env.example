# DeepSeek API Key
# 获取地址: https://platform.deepseek.com  （注册 -> API keys -> 创建）
OPENAI_API_KEY=sk-your-deepseek-api-key-here

# API 地址（DeepSeek 默认值，无需修改）
OPENAI_BASE_URL=https://api.deepseek.com

# 模型选择（可选）
# deepseek-chat: 通用对话，便宜快速（推荐）
# deepseek-reasoner: 深度推理模型
MODEL=deepseek-chat

# 服务器端口（可选）
PORT=3001
